{
  "name": "solana-experiment",
  "packageManager": "yarn@4.2.2",
  "version": "1.0.0",
  "description": "Solana Web3.js Experimental Project",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "clean": "rimraf dist",
    "prebuild": "yarn clean"
  },
  "dependencies": {
    "@solana/web3.js": "^1.90.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "solana",
    "web3",
    "blockchain",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
